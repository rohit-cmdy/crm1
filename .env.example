# Copy to .env and fill in. NEVER commit .env.
# --- WooCommerce REST API (Read access is enough) ---
WOOCOMMERCE_STORE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxx
# --- Webhooks: must equal the "Secret" you enter in the WooCommerce webhook ---
WEBHOOK_SECRET=change-me-to-a-long-random-string
# --- Database: MySQL (create the DB first, see README). SQLite fallback: sqlite:///./crm.db ---
DATABASE_URL=mysql+pymysql://crm_user:your_password@localhost:3306/crm?charset=utf8mb4
# DATABASE_URL=sqlite:///./crm.db
# --- Mode at first start: true = sample data only, false = real WooCommerce (switchable in the UI) ---
DEMO_MODE=false
# --- CORS: the frontend origin allowed to call the API ---
FRONTEND_ORIGIN=http://localhost:5173
# --- Optional tuning ---
SYNC_PER_PAGE=50
SYNC_MAX_PAGES=5
FOLLOWUP_ORDER_STATUSES=completed
FOLLOWUP_DUE_DAYS=3
